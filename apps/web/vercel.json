{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "bash ../../scripts/vercel-build.sh",
  "git": {
    "deploymentEnabled": {
      "master": false,
      "release": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/emails",
      "schedule": "0 16 * * *"
    }
  ]
}
