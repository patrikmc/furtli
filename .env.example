# Copy to apps/web/.env.local (Next.js reads env files from the app
# directory, not the repo root). packages/db/.env only needs DATABASE_URL.

# --- Map (step 1) ---------------------------------------------------------
# Base map style. Default (also used when unset): swisstopo Light Base Map,
# free, keyless, commercial use allowed.
NEXT_PUBLIC_MAP_STYLE_URL=https://vectortiles.geo.admin.ch/styles/ch.swisstopo.lightbasemap.vt/style.json

# --- Database ----------------------------------------------------------------
# Without DATABASE_URL the map serves the 10 sample stations (seed file).
# Local:  postgres://postgres:postgres@localhost:5432/app  (docker compose up -d)
# Neon:   Neon dashboard -> Connect -> *pooled* string (host contains '-pooler')
#         for the app; DATABASE_URL_UNPOOLED (direct) for migrations and `pnpm ingest`.
# Also put these into packages/db/.env (migrations + `pnpm ingest` read it).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app
# DATABASE_URL_UNPOOLED=

# --- Weekly ingest (Vercel Cron -> /api/ingest) --------------------------------
# Any long random string; set the same value in Vercel project settings.
# Vercel sends it as "Authorization: Bearer <CRON_SECRET>". Without it the
# endpoint refuses to run.
# CRON_SECRET=

# --- Analytics: Umami (cookieless) ------------------------------------------------
# Umami Cloud -> Settings -> Websites -> Add website -> copy the Website ID.
# Unset = no tracking script at all (local dev, tests). NEXT_PUBLIC_* values are
# baked in at build time: set them in Vercel before deploying.
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=f8e56fcc-0ef2-402b-bc65-6bd58a0304c6
# Script URL; the default is Umami Cloud. Self-hosted: https://<your-umami>/script.js
# NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
# Only count visits on these hostnames (keeps previews/localhost out of the stats).
# NEXT_PUBLIC_UMAMI_DOMAINS=furtli.ch,www.furtli.ch

# --- Email: Resend -----------------------------------------------------------------
# resend.com -> API Keys (sending access). Unset = emails are printed to the
# server log instead (all links included), so the flow works locally.
# RESEND_API_KEY=
# Sender on a domain verified in Resend (DNS: SPF + DKIM, add DMARC too).
# EMAIL_FROM="Furtli <hallo@furtli.ch>"
# EMAIL_REPLY_TO=hallo@furtli.ch
# Shown in the email footer and on /datenschutz.
# EMAIL_CONTACT_ADDRESS=hallo@furtli.ch
# Base URL for links in emails (production domain). Previews use VERCEL_URL.
# NEXT_PUBLIC_SITE_URL=https://furtli.ch
# The daily email cron (/api/cron/emails) uses CRON_SECRET from above.
