# Copy this file to apps/web/.env.local (Next.js only reads env files from
# the app directory, not the repo root) and packages/db/.env, and fill in
# real values. Both files can be identical — see the root README.

# --- Database -----------------------------------------------------------
# Local:    postgres://postgres:postgres@localhost:5432/app  (docker compose up -d)
# Neon:     get from the Neon dashboard (Connect) — use the *pooled* connection string
#           (host contains '-pooler'). Never paste a real password into this file.
# Supabase: get from Project Settings -> Database — use the pooled (pgbouncer) string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app

# --- Clerk (https://dashboard.clerk.com -> your app -> API Keys) --------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/quizzes
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/quizzes

# --- E2E tests only (`pnpm test:e2e`, apps/web/playwright.config.ts) -----
# @clerk/testing's helpers read the unprefixed CLERK_PUBLISHABLE_KEY (not
# the NEXT_PUBLIC_ one above) — same value, different var name, required
# by their API. Use a Clerk *test* instance's keys here, not production.
CLERK_PUBLISHABLE_KEY=
# A test user's email in Clerk's reserved testing-mode format — always
# passes verification, no real inbox involved. Create the user once
# (sign up through the app, or the Clerk dashboard) with an address like
# you+clerk_test@example.com, then put that address here.
E2E_CLERK_USER_EMAIL=
