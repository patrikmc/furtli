{
  "name": "furtli",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:integration": "pnpm -r --if-present test:integration",
    "test:e2e": "pnpm --filter web test:e2e",
    "release": "bash scripts/promote-release.sh",
    "db:generate": "pnpm --filter db generate",
    "db:migrate": "pnpm --filter db migrate",
    "db:studio": "pnpm --filter db studio",
    "db:reset": "pnpm --filter db reset",
    "ingest": "pnpm --filter ingest ingest",
    "ingest:dry": "pnpm --filter ingest ingest --dry-run",
    "subscriber": "pnpm --filter web subscriber",
    "attribution": "pnpm --filter web attribution",
    "weekly-snapshot": "pnpm --filter web weekly-snapshot",
    "weekly-report": "pnpm --filter web weekly-report",
    "weekly-local": "bash scripts/weekly-local.sh",
    "weekly-collect": "bash scripts/weekly-collect.sh"
  },
  "dependencies": {
    "@neon/config": "^1.7.3",
    "@neon/env": "^1.4.4"
  }
}
